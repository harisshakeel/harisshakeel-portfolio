# GROQ API Key for AI Chatbot (Required)
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Bot Authentication Credentials
NEXT_PUBLIC_BOT_USERNAME=your_username
NEXT_PUBLIC_BOT_PASSWORD=your_password

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://twopixel.vercel.app

# Web Search API Keys (Optional - for Research Mode)
# Option 1: Tavily Search API (Recommended - 1000 free searches/month)
# Get your free API key from: https://tavily.com
# TAVILY_API_KEY=your_tavily_api_key_here

# Option 2: SerpAPI (Alternative - 100 free searches/month)
# Get your API key from: https://serpapi.com
# SERPAPI_KEY=your_serpapi_key_here

# Note: If no search API key is provided, the system will use DuckDuckGo's free API
# For best research results, we recommend getting a free Tavily API key

# Email Service (if using EmailJS)
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
