# Supply-chain hardening. Pairs with the "Protect history" ruleset on GitHub,
# which blocks force pushes and branch deletion.

# Never execute a dependency's pre/post-install scripts. The only three packages
# in this tree that declare them (sharp, fsevents, unrs-resolver) all ship
# prebuilt binaries via optionalDependencies, so installs still succeed.
# If a native binary ever goes missing, rebuild that one package explicitly:
#   npm rebuild sharp
ignore-scripts=true

# Write exact versions instead of caret ranges, so `npm install <pkg>` can't
# silently widen the dependency surface.
save-exact=true

# Refuse to install against an unsupported Node version.
engine-strict=true

# Report moderate-and-above advisories.
audit-level=moderate

fund=false
